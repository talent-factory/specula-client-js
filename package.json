{
  "name": "@talent-factory/specula-client",
  "version": "0.0.0",
  "description": "Shared OTel/Logging/PII-Scrubbing client SDK for Specula-monitored products (JS/TS).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
