  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@types/react": { "optional": true }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
